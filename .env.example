ALLOWED_ORIGINS=
API_PROXY_TARGET=
APP_ENV=
BACKUP_BUCKET=
DATA_BACKEND=
FIREBASE_WEB_API_KEY=
MAIL_FROM=
PORT=
SMTP_URL=

# Telegram bot for the daily 09:00 Excel report to Managers (optional; empty = feature off).
# Flow: after first login the Manager opens the bot, taps Start, and shares their mobile
# number; the bot pairs that chat to the Manager account with the same phone.
# 1) Create a bot with @BotFather → token + public @username.
# 2) Register the webhook WITH a secret (required in production for auto-pairing):
#    https://api.telegram.org/bot<TOKEN>/setWebhook?url=<API>/v1/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TRUST_PROXY_HOPS=
VITE_API_BASE=
VITE_APP_ENV=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_PUSH_ENABLED=
VITE_SENTRY_DSN=

# ── AI mentors (handoff/report: docs/MENTOR-AI.md) ───────────────────────────
# Gemini: text answers, multimodal understanding (image/PDF/video/audio), embeddings and TTS.
# Free tier is enough for the MVP; leave GEMINI_API_KEY empty to run rule-only (no LLM).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Groq: Persian speech-to-text (Whisper, free tier) + the fast classification lane.
# Optional. Without it, voice input falls back to typed text and answers stay on Gemini.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Voice calls: `off` disables the duplex (Live) transport and forces the turn-based fallback.
MENTOR_VOICE_REALTIME=on
# Max media assets one knowledge sweep may read (protects free-tier quota).
KNOWLEDGE_REBUILD_LIMIT=1200
